# ==============================================================================
# .env.example — Smart USB Charger
# คัดลอกไฟล์นี้เป็น .env สำหรับรันบน Local หรือใส่ใน Environment Variables บน Render
# ห้าม commit ไฟล์ .env ที่มีข้อมูลจริงขึ้น Git เด็ดขาด
# ==============================================================================

# --- PromptPay & TrueMoney & Bank Account (ตั้งค่าบัญชีรับเงิน) ---
PROMPTPAY_PHONE=0xxxxxxxxx
TRUEMONEY_PHONE=0xxxxxxxxx
BANK_NAME=ธนาคารของคุณ
BANK_ACCOUNT=xxx-x-xxxxx-x
BANK_ACCOUNT_NAME=ชื่อบัญชีผู้รับเงิน

# --- Pricing & Support Contact ---
# อัตราค่าบริการ (ค่าเริ่มต้น 180 วินาทีต่อ 1 บาท)
SECONDS_PER_BAHT=180
SUPPORT_PHONE=
SUPPORT_LINE=
SUPPORT_IG=
SUPPORT_LOCATION=

# --- Admin Authorization (Google Sign-In Only — ไม่มีระบบ PIN) ---
# ระบุอีเมลผู้ดูแลระบบคั่นด้วยเครื่องหมายจุลภาค (ต้องยืนยันผ่าน Google Firebase ID Token)
# สามารถจัดการรายชื่อเพิ่มเติมได้ใน Firestore collection "admin_whitelist"
ADMIN_EMAILS=admin1@gmail.com,admin2@gmail.com

# --- Hardware Device Security (ESP32) ---
# Preshared Secret ระหว่างเซิร์ฟเวอร์กับบอร์ด ESP32 (ส่งผ่าน Header X-ESP32-Secret เท่านั้น)
ESP32_SECRET=replace_with_long_random_esp32_hardware_secret

# --- Firebase Admin SDK Credentials ---
# ระบุ Path ของไฟล์ JSON หรือใส่ JSON String ทั้งก้อนใน Render ENV
FIREBASE_SERVICE_ACCOUNT=./service-account-key.json

# --- EasySlip API ---
# สมัครที่ https://developer.easyslip.com
# หากไม่ระบุ หรือตรวจสลิปไม่ผ่าน สลิปจะถูกส่งเข้าคิวรออนุมัติโดยผู้ดูแลในหน้า Admin
EASYSLIP_API_KEY=replace_with_your_easyslip_api_key

# --- CORS & Server ---
ALLOWED_ORIGINS=https://usb-charger-project.web.app,http://localhost:3000
PORT=3000
