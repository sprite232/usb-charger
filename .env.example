# ════════════════════════════════════════════
# .env — Smart USB Charger v2
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกข้อมูลจริง
# ════════════════════════════════════════════

# ─── PromptPay ───────────────────────────────
PROMPTPAY_PHONE=0969679951

# ─── บัญชีธนาคาร (สำหรับช่องทาง "โอนธนาคาร") ──
BANK_NAME=ไทยพาณิชย์ (SCB)
BANK_ACCOUNT=123-4-56789-0
BANK_ACCOUNT_NAME=นายชื่อ นามสกุล

# ─── อัตรา ────────────────────────────────────
# 1 บาท = กี่วินาที (ค่าเริ่มต้น 180 = 3 นาที)
SECONDS_PER_BAHT=180

# ─── Admin PIN / Hash ───────────────────────────
# แนะนำสร้าง bcrypt hash ด้วยคำสั่ง: node -e "console.log(require('bcryptjs').hashSync('YourStrongPassword', 10))"
ADMIN_PIN_HASH=$2a$10$exampleBcryptHashGoesHereForProductionUseOnly
# หรือระบุเป็น plaintext PIN ชั่วคราว (ระบบจะ hash ให้อัตโนมัติใน runtime):
ADMIN_PIN=

# ─── Hardware Device Security (ESP32) ───────────
# Preshared Secret ระหว่างเซิร์ฟเวอร์กับบอร์ด ESP32 เพื่อป้องกัน Coin Injection
ESP32_SECRET=your_long_random_esp32_hardware_secret_here

# ─── Firebase Admin SDK Credentials ────────────
# Path หรือ JSON String ของ Service Account Key
FIREBASE_SERVICE_ACCOUNT=./service-account-key.json

# ─── JWT Secret ───────────────────────────────
# เปลี่ยนเป็น random string ยาวๆ เช่น ใช้ pwgen หรือ uuidgen
JWT_SECRET=change-this-to-a-very-long-random-secret-string-at-least-32-chars

# ─── EasySlip API ─────────────────────────────
# สมัครที่ https://developer.easyslip.com
# ถ้าไม่ใส่ → DEV MODE (ข้ามการตรวจ ใช้สำหรับทดสอบเท่านั้น!)
EASYSLIP_API_KEY=your_easyslip_api_key_here

# ─── Server ───────────────────────────────────
PORT=3000
