rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if authenticated user is in the admin whitelist or has admin custom claim (Zero Hardcoded Secrets)
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.admin == true ||
          exists(/databases/$(database)/documents/admin_whitelist/$(request.auth.token.email.lower()))
        );
    }

    // Charger & Port state - anyone can read kiosk status; verified admins can update config; Server Admin SDK has full access
    match /charger/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Internal private charger state & used slip refs - Server Admin SDK only
    match /charger_private/{docId} {
      allow read, write: if false;
    }

    // Transactions ledger - authenticated admins can read; Server Admin SDK writes only
    match /transactions/{txId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Website visits & randomized visitor sessions - admins read; Server Admin SDK writes only
    match /visits/{visitId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Pending slip/voucher approvals - Anyone with exact ID can check status (get); only admins can list all or write
    match /pending_approvals/{pendingId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if false;
    }

    // Admin audit logs - admins read; Server Admin SDK writes only
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin Whitelist - authenticated admins can manage; users can check their own entry
    match /admin_whitelist/{email} {
      allow get: if request.auth != null && 
                 request.auth.token.email != null && 
                 request.auth.token.email.lower() == email.lower();
      allow list, write: if isAdmin();
    }

    // Issues & Support Tickets - customers can create and read status; authorized admins can update/delete
    match /issues/{issueId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
